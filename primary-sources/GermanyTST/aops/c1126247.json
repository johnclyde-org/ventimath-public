    "poster_id": 363884,
    "post_rendered": "Let <img src=\"//latex.artofproblemsolving.com/1/7/4/174fadd07fd54c9afe288e96558c92e0c1da733a.png\" class=\"latex\" alt=\"$n$\"  width=\"10\" height=\"8\" > be a positive integer prove that <img src=\"//latex.artofproblemsolving.com/e/1/0/e109e1259852c6bd5c512aec90cb9ca07b5f07dc.png\" class=\"latexcenter\" alt=\"$$6\\nmid \\lfloor (\\sqrt[3]{28}-3)^{-n} \\rfloor.$$\"  width=\"142\" height=\"22\" >",
