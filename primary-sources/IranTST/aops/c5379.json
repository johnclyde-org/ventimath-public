   "post_data": {
    "post_id": 638816,
    "post_type": "forum",
    "topic_id": 112437,
    "poster_id": 652,
    "post_rendered": "A <img src=\"//latex.artofproblemsolving.com/e/5/e/e5e380e4368f174b9f5f9af26cae02a0ce48bc63.png\" class=\"latex\" alt=\"$10\\times10\\times10$\" style=\"vertical-align: 0px\" width=\"98\" height=\"13\" > cube has <img src=\"//latex.artofproblemsolving.com/6/e/e/6ee927e1332358c96c62c277441c907c4f51057f.png\" class=\"latex\" alt=\"$1000$\" style=\"vertical-align: 0px\" width=\"35\" height=\"13\" > unit cubes. <img src=\"//latex.artofproblemsolving.com/a/3/9/a39b14023c98c943554d150561aacc188c4ce26d.png\" class=\"latex\" alt=\"$500$\"  width=\"26\" height=\"12\" > of them are coloured black and <img src=\"//latex.artofproblemsolving.com/a/3/9/a39b14023c98c943554d150561aacc188c4ce26d.png\" class=\"latex\" alt=\"$500$\"  width=\"26\" height=\"12\" > of them are coloured white. Show that there are at least <img src=\"//latex.artofproblemsolving.com/e/5/9/e59e2c6e83eb78cca610a5fd4070ae01c8d4ae60.png\" class=\"latex\" alt=\"$100$\" style=\"vertical-align: 0px\" width=\"26\" height=\"13\" > unit squares, being the common face of a white and a black unit cube.",
    "post_canonical": "A $10\\times10\\times10$ cube has $1000$ unit cubes. $500$ of them are coloured black and $500$ of them are coloured white. Show that there are at least $100$ unit squares, being the common face of a white and a black unit cube.",
    "username": "Omid Hatami",
    "post_number": 1,
    "post_format": "bbcode",
    "category_name": "High School Olympiads",
    "category_id": 6,
    "poster_avatar": "//avatar.artofproblemsolving.com/avatar_652.png"
   }
