    "topic_id": 151408,
    "poster_id": 652,
    "post_rendered": "Find all polynomials of degree 3, such that for each <span style=\"white-space:nowrap;\"><img src=\"//latex.artofproblemsolving.com/e/2/f/e2f412ca4b26c1ec474cf0e038bbc8b4cf147817.png\" class=\"latex\" alt=\"$x,y\\geq 0$\" style=\"vertical-align: -3px\" width=\"61\" height=\"16\" >:</span> <img src=\"//latex.artofproblemsolving.com/6/d/6/6d602d39d31009a5e22ee347ab41d15cde270c0b.png\" class=\"latexcenter\" alt=\"\\[p(x+y)\\geq p(x)+p(y)\\]\"  width=\"178\" height=\"18\" >",
    "post_canonical": "Find all polynomials of degree 3, such that for each $x,y\\geq 0$: \\[p(x+y)\\geq p(x)+p(y)\\]",
    "username": "Omid Hatami",
