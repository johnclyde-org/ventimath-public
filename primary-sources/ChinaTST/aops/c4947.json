   "post_data": {
    "post_id": 269177,
    "post_type": "forum",
    "topic_id": 42551,
    "poster_id": 651,
    "post_rendered": "Yeah! Federico is our Team leader! he has shown us many times the proof of this beautiful result!<br>\n<br>\nanyway it is to hard to write it down, i just give some hints:<br>\n<br>\nDraw all circles and show that moving a point to another region which is a neighboor of it starting region doesnt change the number of halving circles! (the point may only pass trough one boundary)<br>\n<br>\nConclude this number is invariant<br>\n<br>\nUse induction in <span style=\"white-space:nowrap;\"><img src=\"//latex.artofproblemsolving.com/1/7/4/174fadd07fd54c9afe288e96558c92e0c1da733a.png\" class=\"latex\" alt=\"$n$\"  width=\"10\" height=\"8\" >,</span> to prove for <img src=\"//latex.artofproblemsolving.com/6/3/9/639e85fa2f2bb450812e9c9de2067851e11a04d1.png\" class=\"latex\" alt=\"$2n+1$\" style=\"vertical-align: -1px\" width=\"50\" height=\"13\" > points it is <span style=\"white-space:nowrap;\"><img src=\"//latex.artofproblemsolving.com/6/0/0/6006bba637eef443381fbaff768fa62d9ff41e62.png\" class=\"latex\" alt=\"$n^2$\"  width=\"17\" height=\"15\" >.</span>",
    "post_canonical": "Yeah! Federico is our Team leader! he has shown us many times the proof of this beautiful result!\r\n\r\nanyway it is to hard to write it down, i just give some hints:\r\n\r\nDraw all circles and show that moving a point to another region which is a neighboor of it starting region doesnt change the number of halving circles! (the point may only pass trough one boundary)\r\n\r\nConclude this number is invariant\r\n\r\nUse induction in $n$, to prove for $2n+1$ points it is $n^2$.",
    "username": "Pascual2005",
    "post_number": 4,
    "post_format": "bbcode",
    "category_name": "High School Olympiads",
    "category_id": 6,
    "poster_avatar": "//avatar.artofproblemsolving.com/avatar_651.jpg"
   }
  },
