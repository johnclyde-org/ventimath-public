    "post_rendered": "For all primes <img src=\"//latex.artofproblemsolving.com/6/5/d/65ded4fddb2217293fa277e82eee3d5ef5e3beb1.png\" class=\"latex\" alt=\"$p \\geq 3,$\" style=\"vertical-align: -3px\" width=\"47\" height=\"16\" > define <img src=\"//latex.artofproblemsolving.com/4/0/8/40891ba8c794871f706ebb1a9306f4ba403415b8.png\" class=\"latex\" alt=\"$F(p) = \\sum^{\\frac{p-1}{2}}_{k=1}k^{120}$\" style=\"vertical-align: -20px\" width=\"119\" height=\"56\" > and <span style=\"white-space:nowrap;\"><img src=\"//latex.artofproblemsolving.com/6/8/7/687fd339769ce62c602c5bbcfefe517da7949fb7.png\" class=\"latex\" alt=\"$f(p) = \\frac{1}{2} - \\left\\{ \\frac{F(p)}{p} \\right\\}$\" style=\"vertical-align: -17px\" width=\"159\" height=\"43\" >,</span> where <img src=\"//latex.artofproblemsolving.com/9/c/c/9cc6cb4d105002c1f75702185cfdfd4c56f22ff3.png\" class=\"latex\" alt=\"$\\{x\\} = x - [x],$\" style=\"vertical-align: -5px\" width=\"110\" height=\"19\" > find the value of <img src=\"//latex.artofproblemsolving.com/6/4/b/64bf627ccc1a85780b79ffc1332238c79b4ef0ac.png\" class=\"latex\" alt=\"$f(p).$\" style=\"vertical-align: -4px\" width=\"37\" height=\"18\" >",
