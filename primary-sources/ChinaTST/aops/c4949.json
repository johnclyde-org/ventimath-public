    "post_rendered": "Find all integer solutions to <img src=\"//latex.artofproblemsolving.com/2/6/4/2649344dc41d2d20ad9b876f20b460d6131271e7.png\" class=\"latex\" alt=\"$2 x^4 + 1 = y^2.$\" style=\"vertical-align: -3px\" width=\"103\" height=\"18\" >",
