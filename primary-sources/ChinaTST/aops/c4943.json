  {
   "item_id": 234095,
   "item_text": "2",
   "item_forum_id": 0,
   "item_type": "post",
   "in_feed": null,
   "is_watched": null,
   "item_score": "991",
   "id": "27414",
   "item_level": "991",
   "post_data": {
    "post_id": 234095,
    "post_type": "forum",
    "topic_id": 37429,
    "poster_id": 1991,
    "post_rendered": "Find all positive integer <img src=\"//latex.artofproblemsolving.com/1/7/4/174fadd07fd54c9afe288e96558c92e0c1da733a.png\" class=\"latex\" alt=\"$n$\"  width=\"10\" height=\"8\" > such that the equation <img src=\"//latex.artofproblemsolving.com/1/c/1/1c104abd94ecd445d2d2a7a69b858f7bfa8fe1b2.png\" class=\"latex\" alt=\"$x^3+y^3+z^3=n \\cdot x^2 \\cdot y^2 \\cdot z^2$\" style=\"vertical-align: -3px\" width=\"220\" height=\"18\" > has positive integer solutions.",
    "post_canonical": "Find all positive integer $n$ such that the equation $x^3+y^3+z^3=n \\cdot x^2 \\cdot y^2 \\cdot z^2$ has positive integer solutions.",
    "username": "orl",
    "post_number": 1,
    "post_format": "bbcode",
    "category_name": "High School Olympiads",
    "category_id": 6,
    "poster_avatar": "//avatar.artofproblemsolving.com/avatar_1991.jpg"
   }
