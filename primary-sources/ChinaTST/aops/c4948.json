   "post_data": {
    "post_id": 269086,
    "post_type": "forum",
    "topic_id": 42556,
    "poster_id": 1991,
    "post_rendered": "Let <img src=\"//latex.artofproblemsolving.com/8/5/1/851673b19aa3fcd030466e6e50c9ca3e3ab60d52.png\" class=\"latex\" alt=\"$n \\geq 2, n \\in \\mathbb{N},$\" style=\"vertical-align: -3px\" width=\"102\" height=\"15\" > find the least positive real number <img src=\"//latex.artofproblemsolving.com/c/e/4/ce4588fd900d02afcbd260bc07f54cce49a7dc4a.png\" class=\"latex\" alt=\"$\\lambda$\"  width=\"10\" height=\"13\" > such that for arbitrary <img src=\"//latex.artofproblemsolving.com/7/7/0/77003eb8e01ce4e4b8cbda65cbb1f5f90ce9b722.png\" class=\"latex\" alt=\"$a_i \\in \\mathbb{R}$\" style=\"vertical-align: -2px\" width=\"50\" height=\"14\" > with <img src=\"//latex.artofproblemsolving.com/9/0/c/90ca86ec43238bb475dc1af13cd8f8a85219b7d2.png\" class=\"latex\" alt=\"$i = 1, 2, \\ldots, n$\" style=\"vertical-align: -3px\" width=\"107\" height=\"16\" > and <img src=\"//latex.artofproblemsolving.com/e/2/6/e26e0299416ef155879277663ccbe122ceb0206c.png\" class=\"latex\" alt=\"$b_i \\in \\left[0, \\frac{1}{2}\\right]$\" style=\"vertical-align: -17px\" width=\"80\" height=\"43\" > with <span style=\"white-space:nowrap;\"><img src=\"//latex.artofproblemsolving.com/9/0/c/90ca86ec43238bb475dc1af13cd8f8a85219b7d2.png\" class=\"latex\" alt=\"$i = 1, 2, \\ldots, n$\" style=\"vertical-align: -3px\" width=\"107\" height=\"16\" >,</span> the following holds:<br>\n<br>\n<img src=\"//latex.artofproblemsolving.com/a/d/9/ad9562c7d920bf4ade4be46964baf7b4858845b5.png\" class=\"latexcenter\" alt=\"\\[\\sum^n_{i=1} a_i = \\sum^n_{i=1} b_i = 1 \\Rightarrow \\prod^n_{i=1} a_i \\leq \\lambda \\sum^n_{i=1} a_i b_i.\\]\"  width=\"310\" height=\"47\" >",
    "post_canonical": "Let $n \\geq 2, n \\in \\mathbb{N},$ find the least positive real number $\\lambda$ such that for arbitrary $a_i \\in \\mathbb{R}$ with $i = 1, 2, \\ldots, n$ and $b_i \\in \\left[0, \\frac{1}{2}\\right]$ with $i = 1, 2, \\ldots, n$, the following holds:\r\n\r\n\\[\\sum^n_{i=1} a_i = \\sum^n_{i=1} b_i = 1 \\Rightarrow \\prod^n_{i=1} a_i \\leq \\lambda \\sum^n_{i=1} a_i b_i.\\]",
    "username": "orl",
    "post_number": 1,
    "post_format": "bbcode",
    "category_name": "High School Olympiads",
    "category_id": 6,
    "poster_avatar": "//avatar.artofproblemsolving.com/avatar_1991.jpg"
   }
