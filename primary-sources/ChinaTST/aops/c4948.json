   "post_data": {
    "post_id": 269087,
    "post_type": "forum",
    "topic_id": 42557,
    "poster_id": 1991,
    "post_rendered": "For any prime <span style=\"white-space:nowrap;\"><img src=\"//latex.artofproblemsolving.com/3/6/f/36f73fc1312ee0349b3f3a0f3bd9eb5504339011.png\" class=\"latex\" alt=\"$p$\" style=\"vertical-align: -3px\" width=\"10\" height=\"11\" >,</span> prove that there exists integer <img src=\"//latex.artofproblemsolving.com/1/7/f/17f1249ad95b7682b8316ad21de8ce4ee9fdcf93.png\" class=\"latex\" alt=\"$x_0$\" style=\"vertical-align: -2px\" width=\"16\" height=\"10\" > such that <img src=\"//latex.artofproblemsolving.com/3/a/6/3a6ca2f95cf6d4f004b7b4255606a6f21fde5e26.png\" class=\"latex\" alt=\"$p | (x^2_0 - x_0 + 3)$\" style=\"vertical-align: -4px\" width=\"117\" height=\"19\" > <img src=\"//latex.artofproblemsolving.com/a/6/e/a6ec0db174f3b705df19623976bf4b88ff502f3a.png\" class=\"latex\" alt=\"$\\Leftrightarrow$\" style=\"vertical-align: 0px\" width=\"18\" height=\"10\" > there exists integer <img src=\"//latex.artofproblemsolving.com/7/2/1/721e40b7e0ac4359611aebe48cfb63122a347798.png\" class=\"latex\" alt=\"$y_0$\" style=\"vertical-align: -3px\" width=\"15\" height=\"11\" > such that <img src=\"//latex.artofproblemsolving.com/1/c/2/1c2ea68669febff2baab0a5dd192758028e1a087.png\" class=\"latex\" alt=\"$p | (y^2_0 - y_0 + 25).$\" style=\"vertical-align: -4px\" width=\"128\" height=\"19\" >",
    "post_canonical": "For any prime $p$, prove that there exists integer $x_0$ such that $p | (x^2_0 - x_0 + 3)$ $\\Leftrightarrow$ there exists integer $y_0$ such that $p | (y^2_0 - y_0 + 25).$",
    "username": "orl",
    "post_number": 1,
    "post_format": "bbcode",
    "category_name": "High School Olympiads",
    "category_id": 6,
