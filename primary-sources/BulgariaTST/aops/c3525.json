    "post_rendered": "Find all <img src=\"//latex.artofproblemsolving.com/0/2/2/022940a765ca072793b00931ceecd0f1a8a073f3.png\" class=\"latex\" alt=\"$a\\in\\mathbb{R}$\" style=\"vertical-align: -1px\" width=\"44\" height=\"13\" > for which there exists a non-constant function <img src=\"//latex.artofproblemsolving.com/2/c/0/2c07c395b2bdf8650333231f27eb6d390f6caf26.png\" class=\"latex\" alt=\"$f: (0,1]\\rightarrow\\mathbb{R}$\" style=\"vertical-align: -5px\" width=\"105\" height=\"18\" > such that <img src=\"//latex.artofproblemsolving.com/5/0/f/50f7687d03e8bda8016e45cc16ee0937718f2c3c.png\" class=\"latexcenter\" alt=\"\\[a+f(x+y-xy)+f(x)f(y)\\leq f(x)+f(y)\\]\"  width=\"348\" height=\"18\" > for all <img src=\"//latex.artofproblemsolving.com/9/a/6/9a6aecf71344084b97349af1156c2dba752aee25.png\" class=\"latex\" alt=\"$x,y\\in(0,1].$\" style=\"vertical-align: -5px\" width=\"92\" height=\"18\" >",
    "post_canonical": "Find all $a\\in\\mathbb{R}$ for which there exists a non-constant function $f: (0,1]\\rightarrow\\mathbb{R}$ such that \\[a+f(x+y-xy)+f(x)f(y)\\leq f(x)+f(y)\\] for all $x,y\\in(0,1].$",
